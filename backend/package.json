{
  "name": "back",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "_moduleAliases": {
    "@": "./src",
    "@config": "./src/config",
    "@models": "./src/models",
    "@services": "./src/services",
    "@controllers": "./src/controllers",
    "@middlewares": "./src/middlewares",
    "@utils": "./src/utils",
    "@routes": "./src/routes",
    "@schemas": "./src/schemas",
    "@database": "./database"

  },
  "scripts": {
    "dev": "NODE_ENV=dev node --watch server.js",
    "prod": "NODE_ENV=prod node server.js",
    "migrations:generate": "sequelize-cli migration:generate --name",
    "migrations:run": "sequelize-cli db:migrate",
    "migrations:undo": "sequelize-cli db:migrate:undo",
    "migrations:delete": "sequelize-cli db:migrate:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@libsql/client": "0.14.0",
    "bcrypt": "5.1.1",
    "cloudinary": "2.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^8.16.2",
    "morgan": "1.10.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.14.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.5",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "eslint": "9.7.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "sequelize-cli": "6.6.2"
  }
}
